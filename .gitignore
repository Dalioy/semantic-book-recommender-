# Python
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# OS
.DS_Store

# Secrets
.env

# Raw + processed data — not tracked, downloaded/generated by the pipeline
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Local Chroma vector store — regenerated by src/vector_store/build_index.py
chroma_db/*
!chroma_db/.gitkeep

# Generated result tables (predictions, etc.) — figures are kept (small, illustrative)
results/tables/*
!results/tables/.gitkeep
